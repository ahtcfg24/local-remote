# Bind to all LAN interfaces. Never port-forward this service to the internet.
# For a fixed LAN endpoint, reserve/set the host IPv4 address, then use HOST=<that-address>.
# Windows start.ps1 -InstallFirewall permits this port on Private/Domain LAN profiles only.
HOST=0.0.0.0
PORT=8787

# Stream tuning
FPS=15
QUALITY=0.6
MAX_WIDTH=1920
MAX_CLIENTS=4

# Optional. Leave unset to generate a persistent 256-bit random token in .run/token.
# REMOTE_TOKEN=replace-with-a-long-random-secret

# Windows: apply changes with .\start.ps1 restart. Startup runs in the signed-in
# desktop user's interactive session. SSH/Session 0, lock screens, and UAC are unsupported.

# Bind to all LAN interfaces. Never port-forward this service to the internet.
HOST=0.0.0.0
PORT=8787

# Stream tuning
FPS=15
QUALITY=0.6
MAX_WIDTH=1920
MAX_CLIENTS=4

# Optional. Leave unset to generate a persistent 256-bit random token in .run/token.
# REMOTE_TOKEN=replace-with-a-long-random-secret
